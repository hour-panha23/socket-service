    "test:e2e": "jest --config ./test/jest-e2e.json",
    "m:m": "knex migrate:make -x ts",
    "m:l": "knex migrate:latest",
    "m:r": "knex migrate:rollback",
    "s:m": "knex seed:make -x ts",
    "s:r": "knex seed:run",
    "s:f": "knex seed:run --specific="
  },
